# RAAHI Backend Server Configuration
PORT=5001

# MongoDB Connection URI
# Default connects to local MongoDB instance, viewed via MongoDB Compass
MONGODB_URI=mongodb://localhost:27017/raahi

# Geographical Deduplication Radius (Meters)
POTHOLE_DEDUP_RADIUS_METERS=10

# Reverse Geocoding Configuration (Phase 11)
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=RAAHI-Pothole-Detection/1.0 (local-prototype)
GEOCODING_TIMEOUT_MS=8000

# Google Drive Video Evidence Storage (Phase 12)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5001/api/dev/auth/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Set to true only if you want uploaded files to be accessible to anyone with the link
GOOGLE_DRIVE_SHARE_PUBLIC=false
